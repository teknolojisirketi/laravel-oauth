# Docker Compose — kopyala: cp .env.example .env

COMPOSE_PROJECT_NAME=laravel-oauth

# Network
DOCKER_NETWORK=app_network
DOCKER_NETWORK_DRIVER=bridge

# Ports (host)
NGINX_PORT=8080
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# PostgreSQL
POSTGRES_DB=laravel_oauth
POSTGRES_USER=laravel
POSTGRES_PASSWORD=secret
